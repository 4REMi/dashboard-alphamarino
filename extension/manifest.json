{
  "manifest_version": 3,
  "name": "Alpha Marino — Guardar anuncios",
  "short_name": "AM Ads",
  "version": "0.5.0",
  "description": "Manda anuncios del Ads Manager y de la Biblioteca de anuncios de Meta a un board de Ad Lab.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Guardar anuncios en Ad Lab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/adsmanager/*",
        "https://www.facebook.com/adsmanager/*"
      ],
      "js": [
        "content/common.js",
        "content/ads-manager.js",
        "content/audit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/adsmanager/*",
        "https://www.facebook.com/adsmanager/*"
      ],
      "js": [
        "content/token-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "content/common.js",
        "content/ad-library.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://graph.facebook.com/*",
    "https://adsmanager-graph.facebook.com/*"
  ]
}
